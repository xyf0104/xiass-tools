{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XIASS Tools",
  "version": "1.9.5",
  "identifier": "com.xiass.tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XIASS Tools",
        "width": 1100,
        "height": 760,
        "center": true,
        "minWidth": 760,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "allowDowngrades": false,
      "wix": {
        "upgradeCode": "ECF94FE4-42A4-437A-BE4A-0877FC0EDED0",
        "language": [
          "en-US"
        ]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "XIASS Tools"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "bundleName": "XIASS Tools",
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "externalBin": [
      "../sidecars/wf-bridge/bin/xiass-wf-bridge"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
